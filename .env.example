# Copie para apps/web/.env.local (site) e exporte no terminal para os comandos de ingestão.

# Segredo que autoriza POST/GET /api/jobs/ingerir. Sem ele a ingestão pelo site fica desativada.
# Gere com: openssl rand -hex 32
CRON_SECRET=

# Opcional. Token do GitHub para a listagem de torneios (sem ele: 60 chamadas por hora por IP;
# cada ingestão faz uma).
GITHUB_TOKEN=

# Opcional. Pasta do banco local e do cards.json (padrão: data/ na raiz do repositório).
MTG_DATA_DIR=

# Opcional. Caminho de outro arquivo de cartas (padrão: <dados>/cards.json).
CARDS_FILE=

# --- Docker (docker compose lê o arquivo .env desta pasta) ---

# Porta do site no computador (padrão: 3000).
PORTA=

# Quantos dias de torneios buscar ao subir (padrão: 30).
INGEST_DAYS=

# Tracker: chave gerada na página Conta e pasta onde o Arena grava o Player.log.
# Os arquivos tracker.bat / tracker.command / tracker.sh preenchem os dois sozinhos.
MTG_META_CHAVE=
MTGA_LOG_DIR=
